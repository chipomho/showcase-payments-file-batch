<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:sftp="http://www.mulesoft.org/schema/mule/sftp"
      xmlns:db="http://www.mulesoft.org/schema/mule/db"
      xmlns:os="http://www.mulesoft.org/schema/mule/os"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/sftp http://www.mulesoft.org/schema/mule/sftp/current/mule-sftp.xsd
        http://www.mulesoft.org/schema/mule/db http://www.mulesoft.org/schema/mule/db/current/mule-db.xsd
        http://www.mulesoft.org/schema/mule/os http://www.mulesoft.org/schema/mule/os/current/mule-os.xsd
        http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

    <!--
        Called from the job's On Complete phase, where the payload is the BatchJobResult.
        Counts and the control total come from the database rather than the job counters,
        because a record that passed validation but failed to insert is still "processed".
    -->
    <flow name="write-run-outcome">
        <ee:transform doc:name="Job result">
            <ee:variables>
                <ee:set-variable variableName="jobResult"><![CDATA[%dw 2.0
output application/java
---
{
    runId: payload.batchJobInstanceId,
    totalRecords: payload.totalRecords,
    successfulRecords: payload.successfulRecords,
    failedRecords: payload.failedRecords,
    elapsedMs: payload.elapsedTimeInMillis
}]]></ee:set-variable>
            </ee:variables>
        </ee:transform>

        <os:retrieve doc:name="Run context" key="#[vars.jobResult.runId]" objectStore="batch-run-store" target="run"/>

        <db:select doc:name="Loaded totals" config-ref="finance-db-config" target="loaded"
                   queryTimeout="${db.queryTimeoutSeconds}" queryTimeoutUnit="SECONDS">
            <db:sql><![CDATA[
                SELECT COUNT(*) AS loaded_count, COALESCE(SUM(amount), 0) AS loaded_amount
                  FROM payment
                 WHERE run_id = :runId
            ]]></db:sql>
            <db:input-parameters><![CDATA[#[{ runId: vars.run.runId }]]]></db:input-parameters>
        </db:select>

        <db:select doc:name="Rejected rows" config-ref="finance-db-config" target="rejects"
                   queryTimeout="${db.queryTimeoutSeconds}" queryTimeoutUnit="SECONDS">
            <db:sql><![CDATA[
                SELECT line_number, payment_reference, payee_name, payee_abn, bsb, account_number,
                       amount, payment_date, reasons
                  FROM payment_reject
                 WHERE run_id = :runId
                 ORDER BY line_number
            ]]></db:sql>
            <db:input-parameters><![CDATA[#[{ runId: vars.run.runId }]]]></db:input-parameters>
        </db:select>

        <ee:transform doc:name="Summary">
            <ee:variables>
                <ee:set-variable variableName="summary" resource="dw/mappings/run-summary.dwl"/>
            </ee:variables>
        </ee:transform>

        <sftp:write doc:name="Write summary" config-ref="sftp-config" createParentDirectories="true"
                    path="#[p('sftp.dirs.outbound') ++ '/' ++ dw::modules::Payments::outputFileName(vars.run.fileName, 'summary.json')]">
            <sftp:content><![CDATA[#[output application/json --- vars.summary]]]></sftp:content>
        </sftp:write>

        <choice doc:name="Any rejects?">
            <when expression="#[not isEmpty(vars.rejects)]">
                <sftp:write doc:name="Write rejects" config-ref="sftp-config" createParentDirectories="true"
                            path="#[p('sftp.dirs.outbound') ++ '/' ++ dw::modules::Payments::outputFileName(vars.run.fileName, 'rejects.csv')]">
                    <sftp:content><![CDATA[#[output application/csv header=true --- vars.rejects map dw::modules::Payments::toRejectsCsvRow($)]]]></sftp:content>
                </sftp:write>
            </when>
        </choice>

        <os:store doc:name="Watermark: record outcome" key="#[vars.run.fileName]" objectStore="processed-files-store">
            <os:value><![CDATA[#[{
                runId: vars.run.runId,
                status: vars.summary.status,
                receivedAt: vars.run.receivedAt,
                completedAt: vars.summary.completedAt
            }]]]></os:value>
        </os:store>
        <os:remove doc:name="Forget run context" key="#[vars.run.runId]" objectStore="batch-run-store"/>

        <logger doc:name="Run complete" level="INFO" category="au.chipomho.payments.batch"
                message="#[output application/json indent=false --- { event: 'run.completed' } ++ vars.summary]"/>

        <error-handler>
            <!--
                The payments are already loaded, so there is nothing to roll back. The watermark
                stays at LOADING, which is what an operator looks for before regenerating the
                summary from the payment and payment_reject tables.
            -->
            <on-error-continue doc:name="Outcome not written" type="ANY" logException="true">
                <logger level="ERROR" category="au.chipomho.payments.batch"
                        message="#[output application/json indent=false --- { event: 'run.outcome_failed', runId: vars.jobResult.runId default null }]"/>
            </on-error-continue>
        </error-handler>
    </flow>

</mule>
